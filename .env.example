# Local development environment. Copy to .env and adjust. Never commit real secrets.
#
# The infrastructure block is interpolated by deploy/docker-compose.yml (`make up`).
# The service blocks below are reference values for host-local runs: each process
# reads its own environment. Full per-service variable tables live in
# services/<svc>/AGENTS.md.

# --- Infrastructure (docker-compose) -----------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=mini
POSTGRES_PASSWORD=mini
REDIS_ADDR=localhost:6379
KAFKA_BROKERS=localhost:9092
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio123
MINIO_BUCKET=kyc-documents
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317

# Shared dev switch. AUTH_DEV relaxes the mandatory JWT issuer/audience check for
# local runs and derives the dev JWKS URL for auth, customer and the gateway.
# Never set it where real tokens are accepted.
AUTH_DEV=true

# --- api-gateway (REST :8080, stateless, no gRPC bind) ------------------------
# HTTP_ADDR=:8080
# LOG_LEVEL=info
# OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
# SHUTDOWN_TIMEOUT=10s
# AUTH_JWKS_URL=http://127.0.0.1:8081/.well-known/jwks.json
# AUTH_ISSUER=mini-fintech-auth
# AUTH_AUDIENCE=mini-fintech
# AUTH_GRPC_ADDR=localhost:50051
# CUSTOMER_GRPC_ADDR=localhost:50052
# REDIS_ADDR=localhost:6379
# REDIS_PASSWORD=
# REDIS_DB=0
# RATE_LIMIT_USER_REFILL=100ms
# RATE_LIMIT_USER_BURST=20
# RATE_LIMIT_IP_REFILL=10s
# RATE_LIMIT_IP_BURST=5
# CORS_ALLOWED_ORIGINS=

# --- auth (gRPC :50051, HTTP/JWKS :8081) --------------------------------------
# DATABASE_URL=postgres://auth_app:auth_app@localhost:5432/auth?sslmode=disable
# GRPC_ADDR=:50051
# HTTP_ADDR=:8081
# LOG_LEVEL=info
# OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
# SHUTDOWN_TIMEOUT=10s
# AUTH_JWKS_URL=http://127.0.0.1:8081/.well-known/jwks.json
# AUTH_ISSUER=mini-fintech-auth
# AUTH_AUDIENCE=mini-fintech
# AUTH_JWT_KEY_PATH=deploy/keys/auth_ed25519_private.pem   # make auth-keygen
# AUTH_JWT_KEY_ID=
# AUTH_JWT_PUBLISHED_KEY_PATHS=
# AUTH_ACCESS_TTL=15m
# AUTH_REFRESH_TTL=720h
# KAFKA_BROKERS=localhost:9092
# KAFKA_GROUP=auth.customer-events

# --- customer (gRPC :50052) ---------------------------------------------------
# AUTH_DEV=true derives the dev issuer/audience/JWKS, like auth and the gateway.
# DATABASE_URL=postgres://customer_app:customer_app@localhost:5432/customer?sslmode=disable
# GRPC_ADDR=:50052
# LOG_LEVEL=info
# OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
# SHUTDOWN_TIMEOUT=10s
# AUTH_JWKS_URL=http://127.0.0.1:8081/.well-known/jwks.json
# AUTH_ISSUER=mini-fintech-auth
# AUTH_AUDIENCE=mini-fintech
# KAFKA_BROKERS=localhost:9092
# KAFKA_GROUP=customer-service

# --- example (reference template, gRPC :50059) --------------------------------
DATABASE_URL=postgres://example_app:example_app@localhost:5432/example?sslmode=disable
GRPC_ADDR=:50059
